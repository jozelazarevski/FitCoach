# FitCoach Environment Configuration
# Copy this to .env and fill in your values

# Environment: development | staging | production
FITCOACH_ENV=development

# Database path (default: fitcoach.db in project root)
# FITCOACH_DB=/data/fitcoach.db

# Flask secret key (auto-generated if not set)
# SECRET_KEY=your-secret-key-here

# Admin panel password (CHANGE THIS IN PRODUCTION)
ADMIN_PASSWORD=fitcoach-admin

# CORS origins (comma-separated, or * for dev)
CORS_ORIGINS=*

# Anthropic Claude API
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (local LLM fallback)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Max user data sync size (bytes, default 5MB)
# MAX_SYNC_SIZE_BYTES=5242880

# Server port
PORT=5000
